TARGET_OS=windows

DB_USER=root
DB_PASS=root
DB_HOST=localhost
DB_PORT=5432
DB_NAME=url-shortener
DB_SSLMODE=disable

DB_URL=postgres://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=${DB_SSLMODE}

BASE_URL=http://localhost:8080

JWT_SECRET=some-jwt-secret
JWT_ACCESS_TTL=15m
JWT_ISSUER=url-shortener